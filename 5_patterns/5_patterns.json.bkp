[
    {
        "vulnerability": "XSS",
        "sources": [
            "document.URL",
            "document.referrer",
            "document.cookie"
        ],
        "sanitizers": [
            "DOMPurify.sanitize"
        ],
        "sinks": [
            "innerHTML",
            "document.write",
            "outerHTML",
            "eval"
        ],
        "implicit": "no"
    },
    {
        "vulnerability": "SQL Injection",
        "sources": [
            "req.body",
            "req.query",
            "req.params"
        ],
        "sanitizers": [
            "mysql.escape",
            "sequelize.escape"
        ],
        "sinks": [
            "db.query",
            "db.execute"
        ],
        "implicit": "yes"
    },
    {
        "vulnerability": "CSRF",
        "sources": [
            "req.body",
            "req.cookies",
            "document.cookie"
        ],
        "sanitizers": [
            "csrfToken.validate"
        ],
        "sinks": [
            "res.send",
            "res.redirect",
            "db.query"
        ],
        "implicit": "no"
    },
    {
        "vulnerability": "Open Redirect",
        "sources": [
            "req.query.redirect",
            "req.params.redirect",
            "document.location.href"
        ],
        "sanitizers": [
            "URLSearchParams",
            "validURL"
        ],
        "sinks": [
            "res.redirect",
            "window.location"
        ],
        "implicit": "no"
    },
    {
        "vulnerability": "Insecure File Upload",
        "sources": [
            "req.files",
            "userInput"
        ],
        "sanitizers": [
            "fileType.validate",
            "mime.lookup"
        ],
        "sinks": [
            "fs.writeFile",
            "fs.createWriteStream"
        ],
        "implicit": "no"
    }
]
